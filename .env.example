# --- Core -------------------------------------------------------------------
# Long random string. Signs session cookies and hashes setup codes.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Passcode for the CFBA office area at /admin
STAFF_PASSCODE=

# Public URL of the deployed portal
APP_URL=https://portal.cfbuildingapprovals.com.au

# --- Supabase (leave blank to run in demo mode) -----------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=issued

# --- Monday -----------------------------------------------------------------
MONDAY_TOKEN=
MONDAY_BOARD_ID=7129862365
MONDAY_NEW_GROUP=topics

# --- Microsoft Graph (SharePoint) -------------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Verified CFBuildingApprovals document library
GRAPH_DRIVE_ID=b!oxbzU5lAQEKvJWYnAKhjupmCoJ2xMxdJmKNl5i9NqeWmThm8ndoDTa21nWz9VGAz
GRAPH_CLIENT_FILES_ROOT=CF Building Approvals/CFBA Client Files

# --- Behaviour --------------------------------------------------------------
RETENTION_MONTHS=6

# --- Optional: email delivery for future notifications ----------------------
RESEND_API_KEY=
FROM_EMAIL=no-reply@cfbuildingapprovals.com.au

# --- Vercel Cron ------------------------------------------------------------
CRON_SECRET=

# Mailbox notifications are sent from. Needs Mail.Send on the Graph app.
MAIL_FROM=admin@cfba.com.au
# Published turnaround, e.g. 3-4
TURNAROUND_DAYS=3-4

# Lodgements go straight onto the Monday board when 1 (the default).
# Set to 0 to restore the staff review queue for every lodgement.
AUTO_ACCEPT_LODGEMENTS=1

# Google Maps key for address autocomplete on Lodge a job and the aerial
# underlay in the site plan tool (browser-visible, so restrict it to the
# portal's domains + Maps JavaScript API, Places API (New) and Geocoding API
# in the Google console). Leave blank to run without either — the address
# field falls back to a plain text box and the aerial is never offered.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Landgate / SLIP cadastre (site plan lot boundaries) --------------------
# "Find my lot" on the site plan tool: looks the address up on the State's
# cadastre and draws the real parcel boundary instead of a typed rectangle.
#
# OFF unless CADASTRE_ENABLED=1. The URL below has NOT been called from this
# codebase — the build had no outbound access to services.slip.wa.gov.au — so
# confirm it against Landgate's own service directory before switching this
# on. docs/SPECS.md § 7 has the exact query, what a good answer looks like,
# and how to find the right layer if this one is wrong. Correcting it is this
# variable and a redeploy, never a code change.
CADASTRE_ENABLED=0
CADASTRE_URL=https://services.slip.wa.gov.au/public/rest/services/SLIP_Public_Services/Property_and_Planning/MapServer/6
# Only needed for an authenticated SLIP service. SERVER SIDE ONLY — never
# rename this to NEXT_PUBLIC_ anything; it would be handed to every browser.
CADASTRE_TOKEN=
# What the printed sheet names as the source of the boundary.
CADASTRE_SOURCE_NAME=Landgate cadastre (SLIP)
CADASTRE_TIMEOUT_MS=6000

# --- The board's "Send?" column --------------------------------------------
# The portal moves a card along Send? as a job travels to the client:
#   SENT (set by the office by hand) -> READY -> DOWNLOADED
# It only ever moves forward and never creates a label. These two are the
# rungs the portal writes; set them only if the board spells them differently
# (e.g. SEND_READY_LABEL="Ready to Download"). Confirmed against board
# 7129862365 on 2 Aug 2026 as READY / DOWNLOADED, so the defaults are right.
SEND_READY_LABEL=READY
SEND_DOWNLOADED_LABEL=DOWNLOADED

# --- The evening report ----------------------------------------------------
# 5pm weekdays to OFFICE_EMAIL: anything that should have reached a client
# today and didn't — a lodgement that never made the board, a job issued whose
# files never arrived, a client never told their package was ready, a job
# ready for days and never opened, enquiries waiting on an answer. A clean day
# still sends, two lines, so a quiet day looks quiet instead of looking like
# the report stopped working. Preview it any time from /admin.
DAILY_REPORT_ENABLED=0
# A job the client hasn't opened after this many days gets a line. Not a
# failure on its own — it's how a dead email address shows up.
UNOPENED_AFTER_DAYS=3
